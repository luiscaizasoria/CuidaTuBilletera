# Copia este archivo a .env (ignorado por git). Son valores públicos, no secretos.
# En desarrollo con Metro, los cambios no requieren recompilar el APK.
# En builds con JavaScript empaquetado, cambiar estos valores requiere una nueva build u OTA compatible.

# URL base de la API (sin barra final). Ejemplo: https://controlgastos-api.<subdominio>.workers.dev
EXPO_PUBLIC_API_URL=
# ID de cliente OAuth de tipo Web de Google Cloud (el mismo que GOOGLE_WEB_CLIENT_ID en la API).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
