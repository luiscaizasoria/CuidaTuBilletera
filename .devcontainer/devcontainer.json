// Dev Container de ControlGastos. Ver docs/005-DEVCONTAINER.md.
// ESTADO: probado en Windows 11 + WSL2 + Docker Desktop. El contenedor no se ha reconstruido con la instalacion de EAS CLI (ver docs/005).
{
  "name": "ControlGastos",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "node",

  // Bind del repositorio; la ruta debe coincidir exactamente con workspaceFolder y con los targets de mounts.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ControlGastos,type=bind",
  "workspaceFolder": "/workspaces/ControlGastos",

  // node_modules en volumenes nombrados: no se mezclan binarios de Windows con Linux.
  "mounts": [
    "source=controlgastos-node-modules-${devcontainerId},target=/workspaces/ControlGastos/node_modules,type=volume",
    "source=controlgastos-api-node-modules-${devcontainerId},target=/workspaces/ControlGastos/api/node_modules,type=volume",
    "source=controlgastos-app-node-modules-${devcontainerId},target=/workspaces/ControlGastos/app/node_modules,type=volume"
  ],

  // Solo al crear el contenedor. Los volumenes nuevos nacen root:root: chown NO recursivo
  // sobre los 3 puntos de montaje, npm ci y EAS CLI fijado en el prefijo npm global de node
  // (sin sudo, desde $HOME para no depender del workspace). Si algun paso falla, la creacion
  // informa el error; la ultima comprobacion exige la version exacta de EAS CLI.
  "postCreateCommand": "sudo chown node:node /workspaces/ControlGastos/node_modules /workspaces/ControlGastos/api/node_modules /workspaces/ControlGastos/app/node_modules && npm ci && (cd \"$HOME\" && npm install -g --no-fund --no-audit eas-cli@25.3.0) && eas --version | grep -F 'eas-cli/25.3.0'",

  "forwardPorts": [8787, 8081],
  "portsAttributes": {
    "8787": { "label": "Wrangler", "onAutoForward": "silent" },
    "8081": { "label": "Metro", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
