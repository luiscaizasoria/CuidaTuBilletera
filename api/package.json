{
  "name": "controlgastos-api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "types": "wrangler types --env prod",
    "typecheck": "wrangler types --env prod && tsc --noEmit",
    "build": "wrangler deploy --dry-run --env prod --outdir dist",
    "build:dev": "wrangler deploy --dry-run --env dev --outdir dist"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
