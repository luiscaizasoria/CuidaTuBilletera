{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Freno contra despliegue accidental: el nivel superior es un CENTINELA sin `main`, D1 ni
  // variables. `wrangler deploy` sin `--env` falla con «Missing entry-point» en lugar de
  // publicar algo. Todo despliegue exige --env dev o --env prod.
  "name": "controlgastos-api-sin-entorno",
  "compatibility_date": "2026-10-01",
  "env": {
    "dev": {
      "name": "controlgastos-api-dev",
      "main": "src/index.ts",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "controlgastos-db-dev",
          "database_id": "ed52c4cb-a375-42a3-b0db-f1a2a4bab50a",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "GOOGLE_WEB_CLIENT_ID": "441178517157-d2cfm6jre3hoepj9ltnaqmlrk57negkv.apps.googleusercontent.com",
        "GOOGLE_ANDROID_CLIENT_ID": "441178517157-kdiehkv9jrt4mo4fq7shpt02955e3mkg.apps.googleusercontent.com",
      },
    },
    "prod": {
      "name": "controlgastos-api",
      "main": "src/index.ts",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "controlgastos-db",
          "database_id": "28389243-8297-4854-872a-ec3dc12c02d6",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        // IDs públicos de los clientes OAuth de PROD (proyecto cuidatubilletera-prod); no son secretos.
        // El cliente Android corresponde a la firma de Google Play (docs/011).
        "GOOGLE_WEB_CLIENT_ID": "354384947762-52bi1smmu5kdl19pmg1me8o5iajir3vh.apps.googleusercontent.com",
        "GOOGLE_ANDROID_CLIENT_IDS": "354384947762-1kas80dtritnta9h9e9dc5vll9k9qo2u.apps.googleusercontent.com",
      },
    },
  },
}
